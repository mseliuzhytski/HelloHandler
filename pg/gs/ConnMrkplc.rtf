/* ============================================================
 * STEP 1: Pull "Awaiting shipment" orders from Kohl's (Mirakl)
 * ============================================================ */

function fetchKohlsOrders() {
  const props = PropertiesService.getScriptProperties();
  const baseUrl = "https://kohls-marketplace.mirakl.net" //props.getProperty("KOHLS_MIRAKL_BASE_URL");
  const apiKey = props.getProperty("KOHLS_API_KEY");
  if (!baseUrl || !apiKey) {
    SpreadsheetApp.getUi().alert(
      "Missing Script Properties. Set KOHLS_MIRAKL_BASE_URL and KOHLS_API_KEY " +
      "under Project Settings > Script Properties."
    );
    return;
  }

  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NAME);
  const existingOrderIds = getExistingOrderIds_(sheet);

  const orders = fetchAllKohlsOrders_(baseUrl, apiKey);
  let newRows = [];
  let skippedExisting = 0;

  orders.forEach(function (rawOrder) {
    const mapped = mapOrderFromMirakl_(rawOrder);
    if (!mapped) return;

    if (existingOrderIds.has(mapped.orderId)) {
      skippedExisting++;
      return;
    }

    mapped.items.forEach(function (item) {
      newRows.push([
        mapped.orderId,
        mapped.fullName,
        "", // Name Continued - Mirakl doesn't separate this; leave blank
        mapped.phone,
        mapped.company,
        mapped.address1,
        mapped.address2,
        mapped.city,
        mapped.state,
        mapped.zip,
        item.sku,
        item.quantity,
        "", // Tracking
        "open"
      ]);
    });
  });

  if (newRows.length === 0) {
    SpreadsheetApp.getUi().alert(
      "No new orders to add. (" + skippedExisting + " already in the sheet were skipped.)"
    );
    return;
  }

  const startRow = sheet.getLastRow() + 1;
  sheet.getRange(startRow, 1, newRows.length, newRows[0].length).setValues(newRows);

  SpreadsheetApp.getUi().alert(
    "Added " + newRows.length + " item row(s) from " +
    (orders.length - skippedExisting) + " new order(s). " +
    "(" + skippedExisting + " order(s) already present were skipped.)"
  );
}

/** Fetch every page of "awaiting shipment" orders from Mirakl. */
function fetchAllKohlsOrders_(baseUrl, apiKey) {
  const pageSize = 100;
  let offset = 0;
  let all = [];

  while (true) {
    const url = baseUrl.replace(/\/$/, "") +
      "/api/orders?order_state_codes=SHIPPING&max=" + pageSize + "&offset=" + offset;

    const response = UrlFetchApp.fetch(url, {
      method: "get",
      headers: { Authorization: apiKey },
      muteHttpExceptions: true
    });

    if (response.getResponseCode() !== 200) {
      throw new Error(
        "Mirakl API error (" + response.getResponseCode() + "): " + response.getContentText()
      );
    }

    const data = JSON.parse(response.getContentText());
    const batch = data.orders || [];
    all = all.concat(batch);

    if (batch.length < pageSize) break;
    offset += pageSize;
  }

  return all;
}

/** Maps one raw Mirakl order object into the shape this script needs. */
function mapOrderFromMirakl_(o) {
  const shipTo = (o.customer && o.customer.shipping_address) || {};
  const firstName = shipTo.firstname || "";
  const lastName = shipTo.lastname || "";
  const fullName = (firstName + " " + lastName).trim();

  const items = (o.order_lines || []).map(function (line) {
    return {
      sku: line.offer_sku || line.product_sku || "",
      quantity: line.quantity || 1
    };
  }).filter(function (i) { return i.sku; });

  if (items.length === 0) return null;

  return {
    orderId: String(o.order_id || o.commercial_id || ""),
    fullName: fullName,
    phone: shipTo.phone || shipTo.phone_secondary || "",
    company: shipTo.company || "",
    address1: shipTo.street_1 || "",
    address2: shipTo.street_2 || "",
    city: shipTo.city || "",
    state: shipTo.state || "",
    zip: shipTo.zip_code || "",
    items: items
  };
}

/** Returns a Set of Order # values already present in the sheet. */
function getExistingOrderIds_(sheet) {
  const lastRow = sheet.getLastRow();
  const ids = new Set();
  if (lastRow <= HEADER_ROW) return ids;

  const values = sheet.getRange(HEADER_ROW + 1, COLS.ORDER_ID, lastRow - HEADER_ROW, 1).getValues();
  values.forEach(function (row) {
    if (row[0]) ids.add(String(row[0]));
  });
  return ids;
}

/** Utility: fetch and log ONE raw order so you can confirm Mirakl's actual field names. */
function debugLogOneKohlsOrder() {
  const props = PropertiesService.getScriptProperties();
  const baseUrl = "https://kohlsus-prod.mirakl.net";
  const apiKey = props.getProperty("KOHLS_API_KEY");
  const url = baseUrl.replace(/\/$/, "") + "/api/orders?order_state_codes=SHIPPING&max=1&shop_id=2020";
  const response = UrlFetchApp.fetch(url, {
    method: "get",
    headers: { Authorization: apiKey },
    muteHttpExceptions: true
  });
  Logger.log(response.getContentText());
  Logger.log(response.getResponseCode());
  Logger.log(response.getAllHeaders());
  Logger.log(response.getContentText());
}

/* ============================================================
 * STEP 2: Send OPEN rows to ShipStation via your AWS endpoint
 * ============================================================ */

function sendOpenOrdersToShipStation() {
  const endpointUrl = YOUR_API_ENDPOINT; //props.getProperty("AWS_ENDPOINT_URL");
  if (!endpointUrl) {
    SpreadsheetApp.getUi().alert(
      "Missing Script Property AWS_ENDPOINT_URL. Set it under Project Settings > Script Properties."
    );
    return;
  }

  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NAME);
  const lastRow = sheet.getLastRow();
  if (lastRow <= HEADER_ROW) {
    SpreadsheetApp.getUi().alert("No data rows found.");
    return;
  }

  const numRows = lastRow - HEADER_ROW;
  const values = sheet.getRange(HEADER_ROW + 1, 1, numRows, COLS.STATUS).getValues();

  // Group open rows by Order #, remembering sheet row numbers for later status updates.
  const groups = {}; // orderId -> { header fields..., items: [{sku, quantity}], rowIndices: [] }

  values.forEach(function (row, i) {
    const status = String(row[COLS.STATUS - 1] || "").trim().toLowerCase();
    if (status !== "open") return;

    const orderId = String(row[COLS.ORDER_ID - 1] || "").trim();
    if (!orderId) return;

    const sheetRowNumber = HEADER_ROW + 1 + i;

    if (!groups[orderId]) {

      groups[orderId] = {
        id: orderId,
        firstName: String(row[COLS.NAME - 1] || "").trim(),
        lastName: String(row[COLS.NAME_CONT - 1] || "").trim(),
        phone: row[COLS.PHONE - 1] || "",
        company: row[COLS.COMPANY - 1] || "",
        address: row[COLS.ADDR1 - 1] || "",
        address2: row[COLS.ADDR2 - 1] || "",
        city: row[COLS.CITY - 1] || "",
        state: row[COLS.STATE - 1] || "",
        zip: row[COLS.ZIP - 1] || "",
        items: [],
        rowIndices: []
      };
    }

    groups[orderId].items.push({
      sku: row[COLS.SKU - 1],
      quantity: Number(row[COLS.QTY - 1]) || 1
    });
    groups[orderId].rowIndices.push(sheetRowNumber);
  });

  const orderIds = Object.keys(groups);
  if (orderIds.length === 0) {
    SpreadsheetApp.getUi().alert('No rows with Status "open" found.');
    return;
  }

  const payloadOrders = orderIds.map(function (id) {
    const g = groups[id];
    return {
      id: g.id,
      firstName: g.firstName,
      lastName: g.lastName,
      phone: g.phone,
      company: g.company,
      address: g.address,
      address2: g.address2,
      city: g.city,
      state: g.state,
      zip: g.zip,
      items: g.items
    };
  });

  const props = PropertiesService.getScriptProperties();
  const apiKey = props.getProperty("YOUR_API_KEY");
  const response = UrlFetchApp.fetch(endpointUrl, {
    method: "post",
    contentType: "application/json",
    headers: { "x-api-key": apiKey },
    payload: JSON.stringify({ orders: payloadOrders }),
    muteHttpExceptions: true
  });

  if (response.getResponseCode() !== 200) {
    SpreadsheetApp.getUi().alert(
      "Request failed (" + response.getResponseCode() + "): " + response.getContentText()
    );
    return;
  }

  const data = JSON.parse(response.getContentText());
  const results = data.results || [];
  const resultsById = {};
  results.forEach(function (r) { resultsById[r.id] = r; });

  let successCount = 0;
  let failCount = 0;
  const failures = [];

  orderIds.forEach(function (id) {
    const result = resultsById[id];
    const g = groups[id];
    if (result && result.success) {
      successCount++;
      g.rowIndices.forEach(function (rowNum) {
        sheet.getRange(rowNum, COLS.STATUS).setValue("closed");
      });
    } else {
      failCount++;
      failures.push(id + ": " + (result ? result.error : "no result returned"));
      // leave Status as "open" so it can be retried
    }
  });

  let msg = "Sent " + orderIds.length + " order(s): " + successCount + " succeeded, " + failCount + " failed.";
  if (failures.length > 0) {
    msg += "\n\nFailures:\n" + failures.join("\n");
  }
  SpreadsheetApp.getUi().alert(msg);
}
