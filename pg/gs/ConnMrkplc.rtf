/**
 * KOHLS (MIRAKL) <-> SHIPSTATION MANUAL ORDER WORKBOOK SCRIPT
 * ------------------------------------------------------------
 * Sheet column layout (must match exactly, header row = row 1):
 * A: Order #
 * B: Recipient Full Name
 * C: Name Continued
 * D: Recipient Phone
 * E: Recipient Company
 * F: Address Line 1
 * G: Address Continued
 * H: City
 * I: State
 * J: Postal Code
 * K: Item SKU
 * L: Item Quantity
 * M: Tracking
 * N: Status open/closed
 *
 * SETUP (one time):
 * 1. Extensions > Apps Script > paste this file in as Code.gs
 * 2. Project Settings > Script Properties, add:
 *      KOHLS_MIRAKL_BASE_URL  -> e.g. https://kohls-marketplace.mirakl.net
 *      KOHLS_API_KEY          -> your Mirakl API key
 *      AWS_ENDPOINT_URL       -> e.g. https://your-server.example.com/create-orders-trll
 *                                     https://api.ancienthowl.net
 * 3. Reload the spreadsheet, use the "Kohls <> ShipStation" menu that appears.
 *
 * NOTE ON MIRAKL FIELD NAMES:
 * Mirakl's OR11 "get orders" response field names can vary slightly by
 * marketplace configuration. The parsing below uses the standard Mirakl
 * field names (customer.shipping_address.*, order_lines[].*). Run
 * `debugLogOneKohlsOrder()` first and check the Apps Script execution log
 * to confirm the actual field names Kohl's returns, then adjust
 * mapOrderFromMirakl_() below if anything differs.
 */

const SHEET_NAME = "Kohls"; // change if your tab is named differently
const YOUR_API_ENDPOINT = "https://api.ancienthowl.net/create-orders-mn";
const HEADER_ROW = 10;
const COLS = {
  ORDER_ID: 1,
  NAME: 2,
  NAME_CONT: 3,
  PHONE: 4,
  COMPANY: 5,
  ADDR1: 6,
  ADDR2: 7,
  CITY: 8,
  STATE: 9,
  ZIP: 10,
  SKU: 11,
  QTY: 12,
  TRACKING: 13,
  STATUS: 14
};

