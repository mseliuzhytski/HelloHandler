\cf5 \cb3 \strokec5 var\cf4 \strokec4  \cf6 \strokec6 RECORDS_CYCLE_NAME_CELL\cf4 \strokec4  = \cf7 \strokec7 "B2"\cf4 \strokec4 ;\cb1 \
\
\cf5 \cb3 \strokec5 var\cf4 \strokec4  \cf6 \strokec6 LOG_START_ROW\cf4 \strokec4  = \cf8 \strokec8 11\cf4 \strokec4 ; \cf9 \strokec9 // Records discrepancy log table starts here, never cleared\cf4 \cb1 \strokec4 \
\cf5 \cb3 \strokec5 var\cf4 \strokec4  \cf6 \strokec6 LOG_START_COL\cf4 \strokec4  = \cf8 \strokec8 1\cf4 \strokec4 ;  \cf9 \strokec9 // column A\cf4 \cb1 \strokec4 \
