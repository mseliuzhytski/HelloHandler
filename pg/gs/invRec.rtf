/**
 * INVENTORY / CALIBRATE / COUNT AUTOMATION
 * ------------------------------------------
 * Sheets involved:
 *   - "Inventory"        Col B (2) = item name
 *                         Col C (3) = locations, separated by comma, space, or both
 *                         Col D (4) = quantity
 *   - "Calibrate Cycle"  B3 = number of days
 *                         A5 = dropdown: MENU / Calibrate / Clear / Refresh
 *   - "Records"          B2  = cycle name (user-entered)
 *                         A3  = dropdown: CYCLE MENU / NEW CYCLE
 *                         Row 5 = Day 1, Day 2, ... (one per column, starting col A)
 *                         Row 6 = "Started" / completion date, under the matching day column
 *                         A7  = dropdown: COUNT MENU / START / COMPLETE
 *                         B8  = dropdown: SELECT / Day 1 / Day 2 / ...
 *                         Row 10 = log table header (pre-existing, not managed by this script)
 *                         Row 11+ = permanent log table (never cleared), columns A:M:
 *                           A Cycle name, B Cycle Day, C Date, D Sku, E Counted, F Stock,
 *                           G Difference, H Note, I New, J Refurbished, K Locations,
 *                           L Object, M Buttons (dropdown: options / view)
 *   - "Count"             Pure display/view sheet. Fully rebuilt whenever a log row's
 *                         Buttons cell (col M) is switched to "view". No calculations,
 *                         no menus, nothing persists here between views.
 *
 * External counting server:
 *   - START sends the day's items to POST {SERVER_BASE_URL}{SERVER_START_ENDPOINT}
 *     as a JSON array of [item, "loc1,loc2,...", quantity] entries.
 *   - COMPLETE pulls the day's counted results from POST
 *     {SERVER_BASE_URL}{SERVER_COMPLETE_ENDPOINT}, sending { cycleName, cycleDay }
 *     as the JSON body, and expects a JSON array response where each item is:
 *       [ sku(with "#"), total_number, expected_number, difference_number, note_text,
 *         total_new_number, total_refurbished_number, locations_values(comma-separated),
 *         object_string, ready_conditional(ignored) ]
 *   Both requests are authenticated with header "x-api-key", read from the Script
 *   Property "YOUR_API_KEY" (Project Settings > Script Properties).
 *
 * ============================= CALIBRATE CYCLE =============================
 *   - "Clear": wipes row 11+ in Calibrate Cycle, resets A5 to "MENU".
 *   - "Calibrate": pulls Inventory items with quantity > 0, splits them across
 *     B3 "Calibrate Day" groups so each day's total quantity is as balanced
 *     as possible (LPT algorithm), writes result from row 11, resets A5.
 *   - "Refresh": re-pulls current quantities for items already in the table
 *     (does not change which items/days exist), updates col C and day
 *     Totals in col E, resets A5. Items no longer in Inventory -> qty 0.
 *
 * ================================= RECORDS ==================================
 *   CYCLE MENU (A3):
 *   - "NEW CYCLE": counts how many "Calibrate Day N" blocks exist in
 *     Calibrate Cycle (col A, from row 11 down), clears + rewrites row 5
 *     with "Day 1", "Day 2", ... (starting col A), clears row 6 as well,
 *     rebuilds the B8 dropdown as SELECT + each day, sets B8 to "SELECT",
 *     resets A3 to "CYCLE MENU".
 *
 *   COUNT MENU (A7):
 *   - "START": reads B8. If "SELECT", does nothing (just resets A7).
 *     Otherwise writes "Started" in row 6 under the matching day column,
 *     finds the matching "Calibrate Day N" block in Calibrate Cycle, grabs
 *     its item names, looks up fresh quantity + locations for each item
 *     from Inventory (locations parsed from a comma/space/mixed-delimited
 *     string, sorted ascending by leading number, no-leading-number
 *     locations sorted last), and POSTs the result to the external
 *     counting server. Resets A7 to "COUNT MENU" when done.
 *   - "COMPLETE": reads B2/B8, POSTs { cycleName, cycleDay } to the server's
 *     complete endpoint, and appends one log row (cols A:M) per item
 *     returned, with today's date in col C and "options" as the default
 *     Buttons value (with data validation list "options"/"view"). Every
 *     item returned is logged (no filtering). Then, regardless of whether
 *     any rows were added, writes today's date into row 6 under the
 *     matching day column (replacing "Started"). Resets A7 to
 *     "COUNT MENU" when done.
 *
 *   LOG TABLE Buttons column (col M, row 11+):
 *   - Switching a row's Buttons cell to "view": colors that cell light
 *     green, then clears the Count sheet entirely and rebuilds it as a
 *     single-item view table (see buildCountSheetView) using that row's
 *     Sku/Counted/Stock/Difference/Note/New/Refurbished/Object values.
 *   - Switching back to "options": clears the green background.
 */

var CALIBRATE_SHEET_NAME = "Calibrate Cycle";
var INVENTORY_SHEET_NAME = "Inventory";
var RECORDS_SHEET_NAME   = "Records";
var COUNT_SHEET_NAME     = "Count";

var START_ROW = 11;      // Calibrate Cycle table starts here
var CLEAR_COLS = 5;      // Calibrate Cycle table is columns A:E

var RECORDS_DAY_ROW = 5;        // row where Day 1, Day 2... are written
var RECORDS_STATUS_ROW = 6;     // row where "Started" / completion date go
var RECORDS_DAY_START_COL = 1;  // column A
var RECORDS_MAX_DAY_COLS = 60;  // generous width to clear on refresh
var RECORDS_DAY_CELL = "B8";
var RECORDS_CYCLE_NAME_CELL = "B2";

// Records log table (row 11+, header pre-exists on row 10)
var LOG_START_ROW = 11;
var LOG_START_COL = 1;  // column A
var LOG_NUM_COLS = 13;  // A:M
var LOG_COL_SKU = 4;        // D
var LOG_COL_BUTTONS = 13;   // M

var COLOR_VIEW_GREEN = "#d9ead3"; // light green 3

var TIMEZONE = "America/New_York";
var DATE_FORMAT = "MM/dd/yyyy";

// External counting server
var SERVER_BASE_URL = "https://api.ancienthowl.net";
var SERVER_START_ENDPOINT = "/count-inventory-start";
var SERVER_COMPLETE_ENDPOINT = "/count-inventory-complete";

function testSendToServer(){
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(RECORDS_SHEET_NAME);
  runCountStart(sheet);
}

function onEditHandle(e) {
  if (!e || !e.range) return;

  var sheet = e.range.getSheet();
  var sheetName = sheet.getName();

  // ---------------- Calibrate Cycle sheet ----------------
  if (sheetName === CALIBRATE_SHEET_NAME) {
    if (e.range.getRow() !== 5 || e.range.getColumn() !== 1) return;
    if (e.range.getNumRows() !== 1 || e.range.getNumColumns() !== 1) return;

    var action = e.range.getValue();
    if (action === "Clear") {
      clearCalibrateTable(sheet);
    } else if (action === "Calibrate") {
      runCalibrate(sheet);
    } else if (action === "Refresh") {
      refreshCalibrateQuantities(sheet);
    }
    return;
  }

  // ------------------- Records sheet ----------------------
  if (sheetName === RECORDS_SHEET_NAME) {
    if (e.range.getNumRows() !== 1 || e.range.getNumColumns() !== 1) return;

    var row = e.range.getRow();
    var col = e.range.getColumn();

    // CYCLE MENU (A3)
    if (row === 3 && col === 1) {
      var cycleAction = e.range.getValue();
      if (cycleAction === "NEW CYCLE") {
        runNewCycle(sheet);
      }
      return;
    }

    // COUNT MENU (A7)
    if (row === 7 && col === 1) {
      var countAction = e.range.getValue();
      if (countAction === "START") {
        runCountStart(sheet);
      } else if (countAction === "COMPLETE") {
        runCountComplete(sheet);
      }
      return;
    }

    // Log table Buttons column (col M, row 11+)
    if (row >= LOG_START_ROW && col === LOG_COL_BUTTONS) {
      handleButtonsEdit(sheet, e.range);
      return;
    }
  }
}

/* ============================================================
 *                     CALIBRATE CYCLE LOGIC
 * ============================================================ */

/** Clears row 11+ and resets the dropdown to MENU */
function clearCalibrateTable(sheet) {
  var lastRow = sheet.getMaxRows();
  if (lastRow >= START_ROW) {
    sheet.getRange(START_ROW, 1, lastRow - START_ROW + 1, CLEAR_COLS).clearContent();
  }
  sheet.getRange("A5").setValue("MENU");
}

/** Reads Inventory, balances items across N days, writes the table */
function runCalibrate(sheet) {
  var ui = SpreadsheetApp.getUi();
  var ss = sheet.getParent();
  var invSheet = ss.getSheetByName(INVENTORY_SHEET_NAME);

  if (!invSheet) {
    ui.alert('Sheet "' + INVENTORY_SHEET_NAME + '" not found.');
    sheet.getRange("A5").setValue("MENU");
    return;
  }

  var daysRaw = sheet.getRange("B3").getValue();
  var days = parseInt(daysRaw, 10);
  if (isNaN(days) || days < 1) {
    ui.alert("Please enter a valid number of days (1 or more) in B3.");
    sheet.getRange("A5").setValue("MENU");
    return;
  }

  var lastRow = invSheet.getLastRow();
  if (lastRow < 1) {
    clearCalibrateTable(sheet);
    return;
  }
  var data = invSheet.getRange(1, 2, lastRow, 3).getValues(); // B:D -> [name, locations(unused), qty]

  var items = [];
  data.forEach(function (row) {
    var name = row[0];
    var qty = row[2];
    if (name !== "" && name !== null && typeof qty === "number" && qty > 0) {
      items.push({ name: name, qty: qty });
    }
  });

  clearCalibrateTable(sheet);

  if (items.length === 0) {
    ui.alert("No items with quantity greater than 0 were found in Inventory.");
    return;
  }

  items.sort(function (a, b) { return b.qty - a.qty; });

  var numDays = Math.min(days, items.length);
  var dayTotals = new Array(numDays).fill(0);
  var dayItems = [];
  for (var i = 0; i < numDays; i++) dayItems.push([]);

  items.forEach(function (item) {
    var minIdx = 0;
    for (var i = 1; i < numDays; i++) {
      if (dayTotals[i] < dayTotals[minIdx]) minIdx = i;
    }
    dayItems[minIdx].push(item);
    dayTotals[minIdx] += item.qty;
  });

  var output = [];
  var dayCounter = 1;
  for (var d = 0; d < numDays; d++) {
    if (dayItems[d].length === 0) continue;
    output.push(["Calibrate Day " + dayCounter, "", "", "Total:", dayTotals[d]]);
    dayItems[d].forEach(function (item) {
      output.push(["", item.name, item.qty, "", ""]);
    });
    dayCounter++;
  }

  if (output.length > 0) {
    sheet.getRange(START_ROW, 1, output.length, 5).setValues(output);
  }

  sheet.getRange("A5").setValue("MENU");
}

/**
 * Re-pulls current quantities from Inventory for whatever items are
 * already in the table (rows 11+), without changing which items exist
 * or how they're grouped into days. Updates col C (item qty) and col E
 * (day Total) only.
 */
function refreshCalibrateQuantities(sheet) {
  var ui = SpreadsheetApp.getUi();
  var ss = sheet.getParent();
  var invSheet = ss.getSheetByName(INVENTORY_SHEET_NAME);

  if (!invSheet) {
    ui.alert('Sheet "' + INVENTORY_SHEET_NAME + '" not found.');
    sheet.getRange("A5").setValue("MENU");
    return;
  }

  var lastRow = sheet.getLastRow();
  if (lastRow < START_ROW) {
    sheet.getRange("A5").setValue("MENU");
    return;
  }

  var invLastRow = invSheet.getLastRow();
  var invMap = {};
  if (invLastRow >= 1) {
    var invData = invSheet.getRange(1, 2, invLastRow, 3).getValues(); // B:D
    invData.forEach(function (row) {
      var name = row[0];
      var qty = row[2];
      if (name !== "" && name !== null) {
        invMap[name] = (typeof qty === "number") ? qty : 0;
      }
    });
  }

  var numRows = lastRow - START_ROW + 1;
  var range = sheet.getRange(START_ROW, 1, numRows, 5); // A:E
  var values = range.getValues();

  var missingItems = [];
  var headerIdx = -1;
  var runningTotal = 0;

  for (var i = 0; i < values.length; i++) {
    var row = values[i];
    var colA = row[0];
    var colB = row[1];

    if (colA !== "" && colA !== null) {
      if (headerIdx !== -1) {
        values[headerIdx][4] = runningTotal;
      }
      headerIdx = i;
      runningTotal = 0;
    } else if (colB !== "" && colB !== null) {
      var newQty;
      if (Object.prototype.hasOwnProperty.call(invMap, colB)) {
        newQty = invMap[colB];
      } else {
        newQty = 0;
        missingItems.push(colB);
      }
      values[i][2] = newQty;
      runningTotal += newQty;
    }
  }
  if (headerIdx !== -1) {
    values[headerIdx][4] = runningTotal;
  }

  range.setValues(values);
  sheet.getRange("A5").setValue("MENU");

  if (missingItems.length > 0) {
    ui.alert(
      "These items in the table were not found in Inventory and were set to 0:\n" +
      missingItems.join(", ")
    );
  }
}

/* ============================================================
 *                         RECORDS LOGIC
 * ============================================================ */

/** NEW CYCLE: rebuilds the Day list (row 5), clears row 6, and the B8 dropdown */
function runNewCycle(recordsSheet) {
  var ui = SpreadsheetApp.getUi();
  var ss = recordsSheet.getParent();
  var calSheet = ss.getSheetByName(CALIBRATE_SHEET_NAME);

  if (!calSheet) {
    ui.alert('Sheet "' + CALIBRATE_SHEET_NAME + '" not found.');
    recordsSheet.getRange("A3").setValue("CYCLE MENU");
    return;
  }

  var lastRow = calSheet.getLastRow();
  var dayCount = 0;
  if (lastRow >= START_ROW) {
    var colA = calSheet.getRange(START_ROW, 1, lastRow - START_ROW + 1, 1).getValues();
    colA.forEach(function (row) {
      var val = row[0];
      if (val !== "" && val !== null && String(val).indexOf("Calibrate Day") === 0) {
        dayCount++;
      }
    });
  }

  if (dayCount === 0) {
    ui.alert('No "Calibrate Day" entries found in ' + CALIBRATE_SHEET_NAME + '.');
    recordsSheet.getRange("A3").setValue("CYCLE MENU");
    return;
  }

  // Clear old day labels (row 5) AND old status/date row (row 6)
  recordsSheet.getRange(RECORDS_DAY_ROW, RECORDS_DAY_START_COL, 2, RECORDS_MAX_DAY_COLS).clearContent();

  var dayLabels = [];
  for (var d = 1; d <= dayCount; d++) dayLabels.push("Day " + d);

  recordsSheet.getRange(RECORDS_DAY_ROW, RECORDS_DAY_START_COL, 1, dayLabels.length).setValues([dayLabels]);

  // Rebuild B8 dropdown: SELECT + each day
  var dropdownOptions = ["SELECT"].concat(dayLabels);
  var rule = SpreadsheetApp.newDataValidation()
    .requireValueInList(dropdownOptions, true)
    .setAllowInvalid(false)
    .build();

  var b8 = recordsSheet.getRange(RECORDS_DAY_CELL);
  b8.setDataValidation(rule);
  b8.setValue("SELECT");

  recordsSheet.getRange("A3").setValue("CYCLE MENU");
}

/** Finds the 1-based column in row 5 whose value matches dayLabel exactly. Returns -1 if not found. */
function findDayColumn(recordsSheet, dayLabel) {
  var rowVals = recordsSheet.getRange(RECORDS_DAY_ROW, RECORDS_DAY_START_COL, 1, RECORDS_MAX_DAY_COLS).getValues()[0];
  for (var i = 0; i < rowVals.length; i++) {
    if (rowVals[i] === dayLabel) return RECORDS_DAY_START_COL + i;
  }
  return -1;
}

/**
 * Splits an Inventory location string into individual codes. Handles
 * comma-separated, space-separated, or mixed comma+space delimiters by
 * normalizing commas to spaces first, then splitting on whitespace.
 * e.g. "A10,2B1, 11A" / "A10 2B1 11A" / "A10,2B1,11A" all -> ["A10","2B1","11A"]
 */
function parseLocationsString(raw) {
  if (raw === "" || raw === null || raw === undefined) return [];
  return String(raw)
    .replace(/,/g, " ")
    .trim()
    .split(/\s+/)
    .filter(function (s) { return s !== ""; });
}

/** Extracts a leading integer from a location string; returns Infinity if none (sorts last). */
function leadingLocationNumber(loc) {
  var m = String(loc).match(/^\d+/);
  return m ? parseInt(m[0], 10) : Infinity;
}

/** Sorts locations ascending by their leading number; ties broken alphabetically; no-leading-number locations sort last. */
function sortLocations(locations) {
  return locations.slice().sort(function (a, b) {
    var na = leadingLocationNumber(a);
    var nb = leadingLocationNumber(b);
    if (na !== nb) return na - nb;
    return String(a).localeCompare(String(b));
  });
}

/**
 * Makes an authenticated POST request to the counting server.
 * Returns { ok: true, data } on success (data is the parsed JSON body, or
 * null if the response was empty), or { ok: false, error } on failure.
 */
function callServer(endpointPath, bodyObj) {
  var props = PropertiesService.getScriptProperties();
  var apiKey = props.getProperty("YOUR_API_KEY");

  if (!apiKey) {
    return { ok: false, error: 'Script property "YOUR_API_KEY" is not set. Go to Project Settings > Script Properties to add it.' };
  }

  var url = SERVER_BASE_URL + endpointPath;
  var options = {
    method: "get",
    contentType: "application/json",
    headers: { "x-api-key": apiKey },
    muteHttpExceptions: true
  };
  if(bodyObj){
    options["payload"] = JSON.stringify(bodyObj);
  }

  try {
    var response = UrlFetchApp.fetch(url, options);
    var code = response.getResponseCode();
    if (code < 200 || code >= 300) {
      return { ok: false, error: "Server returned an error (" + code + "):\n" + response.getContentText() };
    }
    var text = response.getContentText();
    if (!text) return { ok: true, data: null };
    try {
      return { ok: true, data: JSON.parse(text) };
    } catch (parseErr) {
      return { ok: false, error: "Could not parse server response as JSON: " + parseErr.message };
    }
  } catch (err) {
    return { ok: false, error: "Failed to reach the server: " + err.message };
  }
}

/** START: pulls the selected day's items from Calibrate Cycle + Inventory and sends them to the server */
function runCountStart(recordsSheet) {
  var ui = SpreadsheetApp.getUi();
  var ss = recordsSheet.getParent();

  var dayValue = recordsSheet.getRange(RECORDS_DAY_CELL).getValue();
  if (dayValue === "SELECT" || dayValue === "" || dayValue === null) {
    recordsSheet.getRange("A7").setValue("COUNT MENU");
    return;
  }

  var match = String(dayValue).match(/\d+/);
  if (!match) {
    ui.alert('Invalid day value in ' + RECORDS_DAY_CELL + ': "' + dayValue + '"');
    recordsSheet.getRange("A7").setValue("COUNT MENU");
    return;
  }
  var targetLabel = "Calibrate Day " + match[0];

  // Mark this day as started in row 6
  var dayCol = findDayColumn(recordsSheet, dayValue);
  if (dayCol !== -1) {
    recordsSheet.getRange(RECORDS_STATUS_ROW, dayCol).setValue("Started");
  }

  var calSheet = ss.getSheetByName(CALIBRATE_SHEET_NAME);
  if (!calSheet) {
    ui.alert('Sheet "' + CALIBRATE_SHEET_NAME + '" not found.');
    recordsSheet.getRange("A7").setValue("COUNT MENU");
    return;
  }

  var itemNames = getItemsForDay(calSheet, targetLabel);
  if (itemNames.length === 0) {
    ui.alert('No items found for "' + targetLabel + '" in ' + CALIBRATE_SHEET_NAME + '.');
    recordsSheet.getRange("A7").setValue("COUNT MENU");
    return;
  }

  var invSheet = ss.getSheetByName(INVENTORY_SHEET_NAME);
  if (!invSheet) {
    ui.alert('Sheet "' + INVENTORY_SHEET_NAME + '" not found.');
    recordsSheet.getRange("A7").setValue("COUNT MENU");
    return;
  }

  var invLastRow = invSheet.getLastRow();
  var invMap = {};
  if (invLastRow >= 1) {
    var invData = invSheet.getRange(1, 2, invLastRow, 3).getValues(); // B:D -> name, locations, qty
    invData.forEach(function (row) {
      var name = row[0];
      var locs = row[1];
      var qty = row[2];
      if (name !== "" && name !== null) {
        invMap[name] = {
          qty: (typeof qty === "number") ? qty : 0,
          locations: sortLocations(parseLocationsString(locs))
        };
      }
    });
  }

  // Build payload: one [item, "loc1,loc2,...", quantity] entry per item
  var payload = [];
  var missing = [];

  itemNames.forEach(function (name) {
    var info = invMap[name];
    if (!info) {
      missing.push(name);
      return;
    }
    payload.push([name, info.locations.join(","), info.qty]);
  });

  if (payload.length > 0) {
    var result = callServer(SERVER_START_ENDPOINT, payload);
    if (!result.ok) {
      ui.alert(result.error);
    }
  }

  recordsSheet.getRange("A7").setValue("COUNT MENU");

  /*if (missing.length > 0) {
    ui.alert(
      "These items from " + targetLabel + " were not found in Inventory and were skipped:\n" +
      missing.join(", ")
    );
  }*/
}

/**
 * COMPLETE: pulls the day's counted results from the server and appends one
 * log row per item to the Records log table (row 11+, never cleared), then
 * marks row 6 with today's date for the selected day (replacing "Started").
 */
function runCountComplete(recordsSheet) {
  var ui = SpreadsheetApp.getUi();

  var cycleName = recordsSheet.getRange(RECORDS_CYCLE_NAME_CELL).getValue();
  var dayValue = recordsSheet.getRange(RECORDS_DAY_CELL).getValue();

  if (dayValue === "SELECT" || dayValue === "" || dayValue === null) {
    ui.alert("Please select a day in " + RECORDS_DAY_CELL + " before completing.");
    recordsSheet.getRange("A7").setValue("COUNT MENU");
    return;
  }

  var result = callServer(SERVER_COMPLETE_ENDPOINT, null); // { cycleName: cycleName, cycleDay: dayValue }
  if (!result.ok) {
    ui.alert(result.error);
    recordsSheet.getRange("A7").setValue("COUNT MENU");
    return;
  }

  var items = result.data;
  if (!Array.isArray(items)) {
    ui.alert("Unexpected response from server: expected an array of items.");
    recordsSheet.getRange("A7").setValue("COUNT MENU");
    return;
  }

  var todayStr = Utilities.formatDate(new Date(), TIMEZONE, DATE_FORMAT);

  let objser = ""; 
  if (items.length > 0) {
    var output = items.map(function (item) {
      objser = item[8].replace(/\n/g, "}{");
      return [
        cycleName, dayValue, todayStr,
        item[0].slice(1), // Sku (already includes "#")
        item[1], // Counted / total_number
        item[2], // Stock / expected_number
        item[3], // Difference
        item[4], // Note
        item[5], // New
        item[6], // Refurbished
        item[7], // Locations
        objser,  //item[8], // Object string
        "options" // Buttons default
      ];
    });

    var nextRow = Math.max(recordsSheet.getLastRow() + 1, LOG_START_ROW);
    recordsSheet.getRange(nextRow, LOG_START_COL, output.length, LOG_NUM_COLS).setValues(output);

    var buttonsRule = SpreadsheetApp.newDataValidation()
      .requireValueInList(["options", "view"], true)
      .setAllowInvalid(false)
      .build();
    recordsSheet.getRange(nextRow, LOG_COL_BUTTONS, output.length, 1).setDataValidation(buttonsRule);
  }

  // Mark the day complete with today's date, regardless of whether any rows were added
  var dayCol = findDayColumn(recordsSheet, dayValue);
  if (dayCol !== -1) {
    recordsSheet.getRange(RECORDS_STATUS_ROW, dayCol).setValue(todayStr);
  } else {
    ui.alert('Could not find column for "' + dayValue + '" in row ' + RECORDS_DAY_ROW + '.');
  }

  recordsSheet.getRange("A7").setValue("COUNT MENU");
}

/** Returns the list of item names under a given "Calibrate Day N" header in Calibrate Cycle */
function getItemsForDay(calSheet, targetLabel) {
  var lastRow = calSheet.getLastRow();
  var items = [];
  if (lastRow < START_ROW) return items;

  var data = calSheet.getRange(START_ROW, 1, lastRow - START_ROW + 1, 2).getValues(); // A:B
  var collecting = false;

  for (var i = 0; i < data.length; i++) {
    var colA = data[i][0];
    var colB = data[i][1];

    if (colA !== "" && colA !== null) {
      collecting = (colA === targetLabel);
      continue; // header row itself has no item
    }
    if (collecting && colB !== "" && colB !== null) {
      items.push(colB);
    }
  }
  return items;
}

/**
 * Handles an edit to a log row's Buttons cell (col M, row 11+).
 * "view" -> highlight green + rebuild the Count sheet as a single-item view.
 * "options" -> clear the highlight.
 */
function handleButtonsEdit(recordsSheet, cellRange) {
  var value = cellRange.getValue();
  var row = cellRange.getRow();

  if (value === "view") {
    //cellRange.setBackground(COLOR_VIEW_GREEN);

    var rowValues = recordsSheet.getRange(row, LOG_COL_SKU, 1, 9).getValues()[0];
    // D..L -> Sku, Counted, Stock, Difference, Note, New, Refurbished, Locations, Object
    var sku = "#"+rowValues[0];
    var counted = rowValues[1];
    var stock = rowValues[2];
    var difference = rowValues[3];
    var note = rowValues[4];
    var newTotal = rowValues[5];
    var refurbTotal = rowValues[6];
    var objectStr = rowValues[8];

    var ss = recordsSheet.getParent();
    var countSheet = ss.getSheetByName(COUNT_SHEET_NAME);
    if (!countSheet) {
      SpreadsheetApp.getUi().alert('Sheet "' + COUNT_SHEET_NAME + '" not found.');
      return;
    }

    buildCountSheetView(countSheet, sku, counted, stock, difference, note, newTotal, refurbTotal, objectStr);
  } else if (value === "options") {
    cellRange.setBackground(null);
  }
}

/* ============================================================
 *                        COUNT SHEET (VIEW ONLY)
 * ============================================================ */

/**
 * Parses an Object string (multiple "\n"-separated lines, each
 * "item,location,newQty,refurbQty") into an array of detail rows.
 * Blank numeric fields are returned as "" (not 0), so the caller can
 * distinguish "not entered" from "entered as zero".
 */
function parseObjectString(objStr) {
  var result = [];
  if (!objStr) return result;

  String(objStr).split("}{").forEach(function (line) {
    if (line === "") return;
    var parts = line.split(",");
    var itemName = parts[0] !== undefined ? parts[0] : "";
    var location = parts[1] !== undefined ? parts[1] : "";
    var newRaw = parts[2] !== undefined ? parts[2] : "";
    var refurbRaw = parts[3] !== undefined ? parts[3] : "";

    var newVal = (newRaw !== "" && !isNaN(Number(newRaw))) ? Number(newRaw) : "";
    var refurbVal = (refurbRaw !== "" && !isNaN(Number(refurbRaw))) ? Number(refurbRaw) : "";

    result.push({ itemName: itemName, location: location, newVal: newVal, refurbVal: refurbVal });
  });

  return result;
}

/**
 * Clears the Count sheet entirely and rebuilds it as a single-item view:
 * a header row, a summary row for the item, and one row per location
 * (parsed from the Object string). Each location row's Total is New +
 * Refurbished (blank if both are blank), matching the Count_Table_Ex format.
 */
function buildCountSheetView(countSheet, sku, counted, stock, difference, note, newTotal, refurbTotal, objectStr) {
  countSheet.clear();

  var header = ["Item", "Location", "New", "Refurbished", "Total", "Expected", "Difference", "Note"];
  var rows = [header];

  rows.push([
    sku, "",
    (newTotal === "" || newTotal === null) ? "" : newTotal,
    (refurbTotal === "" || refurbTotal === null) ? "" : refurbTotal,
    (counted === "" || counted === null) ? "" : counted,
    (stock === "" || stock === null) ? "" : stock,
    (difference === "" || difference === null) ? "" : difference,
    note || ""
  ]);

  var detailRows = parseObjectString(objectStr);
  detailRows.forEach(function (d) {
    var total = "";
    if (d.newVal !== "" || d.refurbVal !== "") {
      total = (d.newVal === "" ? 0 : d.newVal) + (d.refurbVal === "" ? 0 : d.refurbVal);
    }
    rows.push([d.itemName, d.location, d.newVal, d.refurbVal, total, "", "", ""]);
  });

  var numRows = rows.length;
  var numCols = header.length;

  // Force the Location column to plain text so mixed alphanumeric codes
  // (e.g. "01A08" alongside "3") are preserved exactly as given.
  countSheet.getRange(1, 2, numRows, 1).setNumberFormat("@");

  countSheet.getRange(1, 1, numRows, numCols).setValues(rows);
  countSheet.getRange(1, 1, 1, numCols).setFontWeight("bold");

  var sheet = countSheet;
  // After building/writing the table
  const lastRow = sheet.getLastRow();
  const lastColumn = sheet.getLastColumn();
  // Row 2: light gray, first through last column
  sheet.getRange(2, 1, 1, lastColumn).setBackground('#d9d9d9');

  // Column 3 (C): light green, rows 3 through last row
  if (lastRow >= 3) {
    sheet.getRange(3, 3, lastRow - 2, 1).setBackground('#d9ead3');
  }

  // Column 4 (D): light yellow, rows 3 through last row
  if (lastRow >= 3) {
    sheet.getRange(3, 4, lastRow - 2, 1).setBackground('#fff2cc');
  }

  // Column 5 — light blue
  if (lastRow >= 3) {
    sheet.getRange(3, 5, lastRow - 2, 1).setBackground('#cfe2f3');
  }

}
