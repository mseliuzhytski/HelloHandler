}

///     Open Orders


function openOrders(){
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("AwaitingShipment");
  const lastRow = sheet.getLastRow();

  const response = UrlFetchApp.fetch(`${YOUR_SERVER}/ordersdailyopen`, {
    headers: { "x-api-key": YOUR_API_KEY }
  });

  const data = JSON.parse(response.getContentText());
  
  const trackingNumbers = new Set();
  const skuMapVersion = new Map();
  let trackingNumbersPrev = new Set();
  let skuMap = new Map();
  let versionStatus = Number(sheet.getRange("I18").getValue());
  const timestamp = 
    Utilities.formatDate(
      new Date(),
      "America/New_York",
      "h:mm a");

  if (lastRow > 20) {
    const currval = sheet.getRange(20+1, 3, lastRow - 20, 1).getValues();
    const currsku = sheet.getRange(20+1, 4, lastRow - 20, 1).getValues();
    trackingNumbersPrev = new Set(currval.flat().map(String));
    for(let i = 0; i<currsku.length; i++){
      let trysku = currsku[i][0].toString();
      skuMap.set(trysku,(skuMap.get(trysku) || 0)+1);
    }
  }

  if(!versionStatus || versionStatus.length < 1){
    versionStatus = 1;
  } else {
    versionStatus++;
  } 

  // Rows
  const rows = [];
  for(const r of data.rows){
    if(!trackingNumbersPrev.has(r.orderNumber)){

      let quantityModifier = 1;
      let vs = versionStatus;
      if(trackingNumbers.has(r.orderNumber)){
        vs += " N";
      } else {
        trackingNumbers.add(r.orderNumber);
      }
      if(r.quantity > 1){
        vs += " Q-"+r.quantity;
      }

      let vsku = r.sku;
      let notesku = r.skuStatus;
      if(r.skuStatus === "Shop Sku"){
        vsku = fixSku(r.orderNumber,r.sku);     
        if(vsku === "-1"){
          vsku = r.sku;
          if(!inventorySku.has(vsku)){
            notesku = "Unknown sku";
          }
        } else if(vsku[0] === '^'){
          let qnum = "";
          let qis = 0;
          for(let qi = 1; qi<vsku.length; qi++){
            if(vsku[qi] !== '_'){
              qnum += vsku[qi];
            } else {
              quantityModifier = Number(qnum);
              qis = qi;
              qi = vsku.length+1;
            }
          }
          vsku = vsku.slice(qis+1,vsku.length); //fixSku("QM",vsku);
          if(!String(vs).includes("Q")){vs += " Q-"+quantityModifier;}else{}
        } else if (vsku.endsWith("-!amz")) {
          vsku = vsku.slice(0,vsku.length-5);
          notesku = r.sku+" !AMZ";
        } else {
          notesku = r.sku;
        }
      } else {}

      if(r.quantity > 1 || quantityModifier > 1){
        let quantityTotal = r.quantity*quantityModifier;
        for(let ii = 0; ii < quantityTotal; ii++){
          skuMap.set(vsku,(skuMap.get(vsku) || 0)+1);
          skuMapVersion.set(vsku,(skuMapVersion.get(vsku) || 0)+1);
          rows.push([timestamp,1,r.orderNumber,vsku,vs,notesku]);
        }
      } else {
        skuMap.set(vsku,(skuMap.get(vsku) || 0)+1);
        skuMapVersion.set(vsku,(skuMapVersion.get(vsku) || 0)+1);
        rows.push([
          timestamp,
          r.quantity,
          r.orderNumber,
          vsku,
          vs,
          notesku
        ]);
      }
    }
  }

  let ordersCount = trackingNumbers.size;
  if(trackingNumbersPrev.size > 0){
    ordersCount += trackingNumbersPrev.size;
  }else{}
  if(trackingNumbersPrev.size == ordersCount){
    versionStatus--;
  }else{}

  sheet.getRange("B18").setValue(timestamp); 

  sheet.getRange("I18").setValue(versionStatus);

  sheet.getRange("B17").setValue(ordersCount);

  if (rows.length > 0) {
    if(trackingNumbersPrev.size < 1){
      sheet.getRange(20+1, 1, rows.length, 6).setValues(rows);
      let skumapSize = skuMapVersion.size;
      if(skumapSize > 10){
        skumapSize = 10;
      }
      const sortedSkuMapVersion = [...skuMapVersion.entries()]
          .sort((a, b) => b[1] - a[1])
          .slice(0,skumapSize);
      let irownum = 5;
      for(const [s,q] of sortedSkuMapVersion){
        sheet.getRange("B"+irownum).setValue(s);
        sheet.getRange("C"+irownum).setValue(q);
        irownum++;
      }
    } else {
      sheet.getRange(lastRow+1, 1, rows.length, 6).setValues(rows);

      sheet.getRange(20+1,8,lastRow-20,6).clearContent();

      sheet.getRange("I17").setValue(trackingNumbers.size);
      sheet.getRange(20+1, 8, rows.length, 6).setValues(rows);

      let skumapSize = skuMap.size;
      if(skumapSize > 10){
        skumapSize = 10;
      }
      const sortedSkuMap = [...skuMap.entries()]
        .sort((a, b) => b[1] - a[1])
        .slice(0,skumapSize);
      let irownum = 5;
      for(const [s,q] of sortedSkuMap){
        sheet.getRange("B"+irownum).setValue(s);
        sheet.getRange("C"+irownum).setValue(q);
        irownum++;
      }
      skumapSize = skuMapVersion.size;
      if(skumapSize > 10){
        skumapSize = 10;
      }
      const sortedSkuMapVersion = [...skuMapVersion.entries()]
          .sort((a, b) => b[1] - a[1])
          .slice(0,skumapSize);
      irownum = 5;
      for(const [s,q] of sortedSkuMapVersion){
        sheet.getRange("I"+irownum).setValue(s);
        sheet.getRange("J"+irownum).setValue(q);
        irownum++;
      }
    }
  }

  Logger.log(`✅ Synced ${trackingNumbers.size} orders out of ${ordersCount}`);
}

function clearOpenDaily(){
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("AwaitingShipment");
  const lastRow = sheet.getLastRow();

  sheet.getRange("B17").clearContent();
  sheet.getRange("I17").clearContent();
  sheet.getRange("I18").clearContent();
  
  if(lastRow - 20 > 0){
    sheet.getRange(20+1, 1, lastRow - 20, sheet.getMaxColumns())
          .clearContent();
    sheet.getRange(5,2,10,2).clearContent();
    sheet.getRange(5,9,10,2).clearContent();
  }
  console.log('rows cleared: '+(lastRow - 20));
}

function fixSku(onum,osku){

  if(onum === "QM"){
    return internalAdjustmentSku.get(osku);
  }

  let oSpecial = "-1";
  let arr = onum.split('-');
  if(arr.length == 3){
    oSpecial = "Amazon";
  }

  if(oSpecial === "Amazon"){
    if(amazonSku.has(osku)){
      //console.log('sku Amazon fix');
      return amazonSku.get(osku);
    } else if(osku.endsWith("-FBM")){
      let nofbmsku = osku.slice(0,osku.length-4);
      if(inventorySku.has(nofbmsku)){
        return nofbmsku;
      }
    } else {}
  } else {}
  if(generalSku.has(osku)){
    //console.log('sku General fix');
    return generalSku.get(osku);
  } else {}
  if(internalAdjustmentSku.has(osku)){
    //console.log('sku General fix');
    return internalAdjustmentSku.get(osku);
  } else {}
  return "-1";
}
