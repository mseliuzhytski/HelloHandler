function syncOrders() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NAME);
  const lastRow = sheet.getLastRow();

  const response = UrlFetchApp.fetch(`${YOUR_SERVER}/ordersdaily`, {
    headers: { "x-api-key": YOUR_API_KEY }
  });

  const data = JSON.parse(response.getContentText());

  const trackingNumbers = new Set();
  const lotSets = [];

  if (lastRow > 10) {
    sheet.getRange(10+1, 1, lastRow - 10, sheet.getMaxColumns())
         .clearContent();
    sheet.getRange(10+1, 1, lastRow - 10, sheet.getMaxColumns())
         .clearDataValidations();
  }

  sheet.getRange("B7").setValue(
  Utilities.formatDate(
    new Date(),
    "America/New_York",
    "MMM d, yyyy h:mm:ss a z"
  ));

  const timestamp = 
    Utilities.formatDate(
      new Date(),
      "America/New_York",
      "h:mm a");

  const rule = SpreadsheetApp.newDataValidation()
    .requireValueInList(["Lot # and quantity","Lot 893465 - 13498", "Lot 123 - 98", "Lot 345 - 309"], true)
    .build();

  sheet.getRange("B3").setDataValidation(rule);
  sheet.getRange("B3").setValue("Lot # and quantity");
  sheet.getRange("B6").setValue("SCHEDULED");

  /*
  // Headers
  sheet.getRange(9,1,1,13).setValues([[
    "Order Number",
    "Tracking Number",
    "Sku",
    "Quantity",
    "Lot Number (Sort)",
    "Name",
    "Img",
    "Ship Date",
    "Ship To Name",
    "Address",
    "Service Cost", 
    "Service", 
    "Voided"
  ]]);
  */

  // Rows
  const rows = [];
  for(const r of data.rows){
    let quantityModifier = 1;
    let vs = 1;
    if(trackingNumbers.has(r.orderNumber)){
      vs += " N";
    } else {
      trackingNumbers.add(r.orderNumber);
    }
    if(r.quantity > 1){
      vs += " Q-"+r.quantity;
    }

    let vsku = fixSku(r.orderNumber,r.sku);
    let notesku = "sku";
    if(vsku === "-1"){
      vsku = r.sku;
      if(!inventorySku.has(vsku)){
        notesku = "Unknown sku";
      }
    } else if(vsku[0] === '^'){
      let qnum = "";
      let qis = 0;
      for(let qi = 1; qi<vsku.length; qi++){
        if(vsku[qi] !== '_'){
          qnum += vsku[qi];
        } else {
          quantityModifier = Number(qnum);
          qis = qi;
          qi = vsku.length+1;
        }
      }
      vsku = vsku.slice(qis+1,vsku.length); //fixSku("QM",vsku);
      if(!String(vs).includes("Q")){vs += " Q-"+quantityModifier;}else{}
      notesku = r.sku;
    } else if (vsku.endsWith("-!amz")) {
      vsku = vsku.slice(0,vsku.length-5);
      notesku = r.sku+" !AMZ";
    } else {
      notesku = r.sku;
    }
    
    if(r.quantity > 1){
      quantityModifier *= r.quantity;
    }
    for(let ii = 0; ii < quantityModifier; ii++){
      lotSets.push([
        "view",
        timestamp,
        "Qx: "+r.quantity,
        r.orderNumber,
        vsku,
        r.trackingNumber,
        vs,
        notesku,
        r.service,
        r.serviceCost,
        r.shipDate
      ]);
      rows.push([
        timestamp,
        1,
        r.orderNumber,
        vsku,
        r.trackingNumber,
        vs,
        notesku,
        r.service,
        r.serviceCost,
        "ERROR: lot num",
        r.shipDate,
        r.itemImg,
        r.name,
        r.shipToName,
        r.address
      ]);
    }
  }

  if (rows.length > 0) {
    sheet.getRange("B5").setValue(trackingNumbers.size);
    sheet.getRange(10+1, 1, rows.length, 15).setValues(rows);

    let rownum = 10+1;
    for(const rule of lotSets){
      const rowrule = SpreadsheetApp.newDataValidation()
        .requireValueInList(rule, true).build();
      sheet.getRange("J"+rownum).setDataValidation(rowrule);
      sheet.getRange("J"+rownum).setValue("view");
      rownum++; 
    }
  } else {
    sheet.getRange("B5").setValue("NO DATA");
  }

  Logger.log(`✅ Synced ${data.orderCount} orders for ${data.date}`);
}

