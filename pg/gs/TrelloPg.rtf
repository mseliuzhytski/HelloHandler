const YOUR_SERVER = "https://api.ancienthowl.net";

// Column positions (1-indexed) — adjust if your columns are in a different order
const COL = {
  ID: 1,
  FIRST_NAME: 9,
  LAST_NAME: 10,
  ADDRESS: 11,
  ADDRESS2: 12,
  CITY: 13,
  ZIP: 14,
  STATE: 15,
  WEIGHT: 16,
  SKU: 20,
  TRACKING: 21,
  STATUS: 22
};

function sendOrdersToShipStationSL(){
  sendOrdersToShipStation("SL");
}
function sendOrdersToShipStationRL(){
  sendOrdersToShipStation("RL");
}
function fetchTrackingNumbersSL() {
  fetchTrackingNumbers("SL");
}
function fetchTrackingNumbersRL() {
  fetchTrackingNumbers("RL");
}

function sendOrdersToShipStation(sname) {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(sname);
  const data = sheet.getDataRange().getValues();

  const ordersToSend = [];
  const rowIndexes = []; // track which sheet rows correspond to which orders

  // Start at row 2 to skip header
  for (let i = 11-1; i < data.length; i++) {
    const row = data[i];
    const status = (row[COL.STATUS - 1] || "").toString().trim().toLowerCase();
    const tracking = row[COL.TRACKING - 1];

    console.log("s: "+status+"!");

    if (status === "open" && !tracking) {
      ordersToSend.push({
        id: row[COL.ID - 1],
        firstName: row[COL.FIRST_NAME - 1],
        lastName: row[COL.LAST_NAME - 1],
        address: row[COL.ADDRESS - 1],
        address2: row[COL.ADDRESS2 - 1],
        city: row[COL.CITY - 1],
        zip: row[COL.ZIP - 1],
        state: row[COL.STATE - 1],
        sku: row[COL.SKU - 1],
        weight: row[COL.WEIGHT -1]
      });
      rowIndexes.push(i + 1); // +1 because sheet rows are 1-indexed
    }
  }

  if (ordersToSend.length === 0) {
    SpreadsheetApp.getUi().alert("No open orders to send (Status must be 'open' and Tracking # blank).");
    return;
  }

  const confirm = SpreadsheetApp.getUi().alert(
    `Send ${ordersToSend.length} order(s) to ShipStation?`,
    SpreadsheetApp.getUi().ButtonSet.YES_NO
  );

  if (confirm !== SpreadsheetApp.getUi().Button.YES) return;

  const props = PropertiesService.getScriptProperties();
  const apiKey = props.getProperty("YOUR_API_KEY");
  const response = UrlFetchApp.fetch(`${YOUR_SERVER}/create-orders-trll`, {
    method: "post",
    contentType: "application/json",
    headers: { "x-api-key": apiKey },
    payload: JSON.stringify({ orders: ordersToSend }),
    muteHttpExceptions: true
  });

  const result = JSON.parse(response.getContentText());

  // Mark each row based on success/failure
  let successCount = 0;
  let failCount = 0;

  result.results.forEach((r, idx) => {
    const sheetRow = rowIndexes[idx];
    if (r.success) {
      sheet.getRange(sheetRow, COL.STATUS).setValue("sent");
      successCount++;
    } else {
      sheet.getRange(sheetRow, COL.STATUS).setValue("error: " + r.error);
      failCount++;
    }
  });

  SpreadsheetApp.getUi().alert(`Done. ${successCount} succeeded, ${failCount} failed.`);
}

function fetchTrackingNumbers(sname) {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(sname);
  const data = sheet.getDataRange().getValues();

  // Collect all "sent" rows
  const sentRows = [];
  for (let i = 11-1; i < data.length; i++) {
    const status = (data[i][COL.STATUS - 1] || "").toString().trim().toLowerCase();
    if (status === "sent") {
      sentRows.push({
        rowIndex: i + 1,
        id: data[i][COL.ID - 1],
        orderNumber: data[i][COL.ID - 1]
      });
    }
  }

  const confirm = SpreadsheetApp.getUi().alert(
    `Fill in tracking numbers from ShipStation?`,
    SpreadsheetApp.getUi().ButtonSet.YES_NO
  );

  if (confirm !== SpreadsheetApp.getUi().Button.YES) return;

  if (sentRows.length === 0) {
    SpreadsheetApp.getUi().alert("No orders with Status 'sent' found.");
    return;
  }

  const orderNumbers = sentRows.map(r => r.orderNumber).join(",");

  const props = PropertiesService.getScriptProperties();
  const apiKey = props.getProperty("YOUR_API_KEY");
  const response = UrlFetchApp.fetch(
    `${YOUR_SERVER}/tracking-list?orderNumbers=${encodeURIComponent(orderNumbers)}`,
    {
      method: "get",
      headers: { "x-api-key": apiKey },
      muteHttpExceptions: true
    }
  );

  const result = JSON.parse(response.getContentText());

  // Build a lookup map: orderNumber → trackingNumber
  const trackingMap = {};
  result.results.forEach(r => {
    trackingMap[r.orderNumber] = r.trackingNumber;
  });

  // Write tracking numbers back to sheet
  let updatedCount = 0;
  let notReadyCount = 0;

  sentRows.forEach(row => {
    const tracking = trackingMap[row.orderNumber];
    if (tracking) {
      sheet.getRange(row.rowIndex, COL.TRACKING).setValue(tracking);
      sheet.getRange(row.rowIndex, COL.STATUS).setValue("closed");
      updatedCount++;
    } else {
      notReadyCount++;
    }
  });

  SpreadsheetApp.getUi().alert(
    `Done.\n✅ ${updatedCount} tracking number(s) added.\n⏳ ${notReadyCount} order(s) not shipped yet.`
  );
}

function updateShipFromLocation() {
  const props = PropertiesService.getScriptProperties();
  const apiKey = props.getProperty("YOUR_API_KEY");
  //const YOUR_SERVER = props.getProperty("YOUR_SERVER"); // e.g. https://api.yourdomain.com
 
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("RL");
 
  const locationName = sheet.getRange("D7").getValue();
  const [firstName, lastName, address1, address2, city, zip, state] =
    sheet.getRange("B8:H8").getValues()[0];
 
  const payload = {
    locationName: String(locationName).trim(),
    firstName: String(firstName || ""),
    lastName: String(lastName || ""),
    address1: String(address1 || ""),
    address2: String(address2 || ""),
    city: String(city || ""),
    zip: String(zip || ""),
    state: String(state || ""),
  };
 
  const response = UrlFetchApp.fetch(`${YOUR_SERVER}/update-ship-from`, {
    method: "post",
    contentType: "application/json",
    headers: { "x-api-key": apiKey },
    payload: JSON.stringify(payload),
    muteHttpExceptions: true,
  });
 
  const status = response.getResponseCode();
  const body = response.getContentText();
 
  if (status !== 200) {
    Logger.log(`Update failed (${status}): ${body}`);
    SpreadsheetApp.getUi().alert(`Update failed: ${body}`);
    return;
  }
 
  Logger.log(`Update succeeded: ${body}`);
  SpreadsheetApp.getUi().alert("Ship From Location updated successfully.");
}
